SELECT
  e/ehr_id/value AS ehr_id,
  c/composition[openehr-ehr-composition.outpatient_high_complexity_procedures.v1]/outpatient_high_complexity_procedures/admin_entry[openehr-ehr-admin_entry.high_complexity_procedures_sus.v1]/hcpa/item_tree[at0001]/components/cluster[at0023]/general_data/element[at0028]/state/value AS state
FROM EHR e
CONTAINS COMPOSITION c
WHERE
  c/composition[openehr-ehr-composition.outpatient_high_complexity_procedures.v1]/outpatient_high_complexity_procedures/admin_entry[openehr-ehr-admin_entry.high_complexity_procedures_sus.v1]/hcpa/item_tree[at0001]/components/cluster[at0023]/general_data/element[at0028]/state/value = 'São Paulo'
