SELECT
  e/ehr_id/value AS ehr_id,
  c/composition[openehr-ehr-composition.outpatient_high_complexity_procedures.v1]/outpatient_high_complexity_procedures/admin_entry[openehr-ehr-admin_entry.high_complexity_procedures_sus.v1]/hcpa/item_tree[at0001]/components/cluster[at0023]/general_data/element[at0012]/patient_age/value AS patient_age,
  c/composition[openehr-ehr-composition.outpatient_high_complexity_procedures.v1]/outpatient_high_complexity_procedures/evaluation[openehr-ehr-evaluation.problem_diagnosis-sus.v1]/problem_diagnosis/item_tree[at0001]/structure/element[at0002.1]/problem/value AS problem
FROM EHR e
CONTAINS COMPOSITION c
WHERE
  c/composition[openehr-ehr-composition.outpatient_high_complexity_procedures.v1]/outpatient_high_complexity_procedures/admin_entry[openehr-ehr-admin_entry.high_complexity_procedures_sus.v1]/hcpa/item_tree[at0001]/components/cluster[at0023]/general_data/element[at0012]/patient_age/value > '60'
  AND c/composition[openehr-ehr-composition.outpatient_high_complexity_procedures.v1]/outpatient_high_complexity_procedures/evaluation[openehr-ehr-evaluation.problem_diagnosis-sus.v1]/problem_diagnosis/item_tree[at0001]/structure/element[at0002.1]/problem/value = 'lung cancer'
