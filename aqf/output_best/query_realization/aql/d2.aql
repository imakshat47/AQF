SELECT
  e/ehr_id/value AS ehr_id,
  c/composition[openehr-ehr-composition.demographic_data.v1]/demographic_data/admin_entry[openehr-ehr-admin_entry.demographic_data.v1]/demographic_data/item_tree[at0001]/components/element[at0002]/birth_date/value AS birth_date
FROM EHR e
CONTAINS COMPOSITION c
WHERE
  c/composition[openehr-ehr-composition.demographic_data.v1]/demographic_data/admin_entry[openehr-ehr-admin_entry.demographic_data.v1]/demographic_data/item_tree[at0001]/components/element[at0002]/birth_date/value < '1970-01-01'
