SELECT
  e/ehr_id/value AS ehr_id,
  c/composition[openehr-ehr-composition.outpatient_high_complexity_procedures.v1]/outpatient_high_complexity_procedures/evaluation[openehr-ehr-evaluation.bariatric_surgery_evaluation.v1]/bariatric_surgery_evaluation/item_tree[at0001]/components/element[at0002]/duration_of_follow-up_(months)/value AS duration_of_treatment
FROM EHR e
CONTAINS COMPOSITION c
WHERE
  c/composition[openehr-ehr-composition.outpatient_high_complexity_procedures.v1]/outpatient_high_complexity_procedures/evaluation[openehr-ehr-evaluation.bariatric_surgery_evaluation.v1]/bariatric_surgery_evaluation/item_tree[at0001]/components/element[at0002]/duration_of_follow-up_(months)/value > '90'
