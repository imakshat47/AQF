SELECT
  e/ehr_id/value AS ehr_id,
  c/composition[openehr-ehr-composition.outpatient_high_complexity_procedures.v1]/outpatient_high_complexity_procedures/evaluation[openehr-ehr-evaluation.problem_diagnosis-sus.v1]/problem_diagnosis/item_tree[at0001]/structure/cluster[openehr-ehr-cluster.tnm_staging-sus.v1]/tumour_-_tnm_cancer_staging/cluster[at0006]/pathological_(ptnm)/element[at0.44]/date_of_pathological_identification/value AS date_of_pathological_identification
FROM EHR e
CONTAINS COMPOSITION c
WHERE
  c/composition[openehr-ehr-composition.outpatient_high_complexity_procedures.v1]/outpatient_high_complexity_procedures/evaluation[openehr-ehr-evaluation.problem_diagnosis-sus.v1]/problem_diagnosis/item_tree[at0001]/structure/cluster[openehr-ehr-cluster.tnm_staging-sus.v1]/tumour_-_tnm_cancer_staging/cluster[at0006]/pathological_(ptnm)/element[at0.44]/date_of_pathological_identification/value >= '2020-01-01' AND c/composition[openehr-ehr-composition.outpatient_high_complexity_procedures.v1]/outpatient_high_complexity_procedures/evaluation[openehr-ehr-evaluation.problem_diagnosis-sus.v1]/problem_diagnosis/item_tree[at0001]/structure/cluster[openehr-ehr-cluster.tnm_staging-sus.v1]/tumour_-_tnm_cancer_staging/cluster[at0006]/pathological_(ptnm)/element[at0.44]/date_of_pathological_identification/value <= '2020-12-31'
