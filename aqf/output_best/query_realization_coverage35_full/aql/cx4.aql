SELECT
  e/ehr_id/value AS ehr_id,
  c/composition[openehr-ehr-composition.outpatient_high_complexity_procedures.v1]/outpatient_high_complexity_procedures/evaluation[openehr-ehr-evaluation.problem_diagnosis-sus.v1]/problem_diagnosis/item_tree[at0001]/structure/cluster[openehr-ehr-cluster.tnm_staging-sus.v1]/tumour_-_tnm_cancer_staging/cluster[at0002]/clinical_(ctnm)/element[at0010]/clinical_staging/value AS clinical_staging,
  c/composition[openehr-ehr-composition.outpatient_high_complexity_procedures.v1]/outpatient_high_complexity_procedures/action[openehr-ehr-action.procedure-sus.v1]/procedure_undertaken/item_tree[at0001]/procedure_list/element[at0002]/procedure/value AS procedure,
  c/composition[openehr-ehr-composition.outpatient_high_complexity_procedures.v1]/outpatient_high_complexity_procedures/admin_entry[openehr-ehr-admin_entry.high_complexity_procedures_sus.v1]/hcpa/item_tree[at0001]/components/cluster[at0016]/chemotherapy/element[at0031]/date_of_beginning_of_chemotherapy/value AS date_of_beginning_of_chemotherapy
FROM EHR e
CONTAINS COMPOSITION c
WHERE
  c/composition[openehr-ehr-composition.outpatient_high_complexity_procedures.v1]/outpatient_high_complexity_procedures/evaluation[openehr-ehr-evaluation.problem_diagnosis-sus.v1]/problem_diagnosis/item_tree[at0001]/structure/cluster[openehr-ehr-cluster.tnm_staging-sus.v1]/tumour_-_tnm_cancer_staging/cluster[at0002]/clinical_(ctnm)/element[at0010]/clinical_staging/value = 'Stage III'
  AND c/composition[openehr-ehr-composition.outpatient_high_complexity_procedures.v1]/outpatient_high_complexity_procedures/action[openehr-ehr-action.procedure-sus.v1]/procedure_undertaken/item_tree[at0001]/procedure_list/element[at0002]/procedure/value = 'biopsy'
  AND c/composition[openehr-ehr-composition.outpatient_high_complexity_procedures.v1]/outpatient_high_complexity_procedures/admin_entry[openehr-ehr-admin_entry.high_complexity_procedures_sus.v1]/hcpa/item_tree[at0001]/components/cluster[at0016]/chemotherapy/element[at0031]/date_of_beginning_of_chemotherapy/value > '2022-01-01'
