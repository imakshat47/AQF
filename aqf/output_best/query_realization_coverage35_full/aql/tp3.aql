SELECT
  e/ehr_id/value AS ehr_id,
  c/composition[openehr-ehr-composition.outpatient_high_complexity_procedures.v1]/outpatient_high_complexity_procedures/action[openehr-ehr-action.procedure-sus.v1]/procedure_undertaken/item_tree[at0001]/procedure_list/element[at0.61]/fields_insertions_1/value AS fields_insertions_1,
  c/composition[openehr-ehr-composition.outpatient_high_complexity_procedures.v1]/outpatient_high_complexity_procedures/action[openehr-ehr-action.procedure-sus.v1]/procedure_undertaken/item_tree[at0001]/procedure_list/element[at0.59]/irradiated_area_2/value AS fields_insertions_2
FROM EHR e
CONTAINS COMPOSITION c
WHERE
  c/composition[openehr-ehr-composition.outpatient_high_complexity_procedures.v1]/outpatient_high_complexity_procedures/action[openehr-ehr-action.procedure-sus.v1]/procedure_undertaken/item_tree[at0001]/procedure_list/element[at0.61]/fields_insertions_1/value IS NOT NULL
  AND c/composition[openehr-ehr-composition.outpatient_high_complexity_procedures.v1]/outpatient_high_complexity_procedures/action[openehr-ehr-action.procedure-sus.v1]/procedure_undertaken/item_tree[at0001]/procedure_list/element[at0.59]/irradiated_area_2/value IS NOT NULL
