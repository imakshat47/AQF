SELECT
  e/ehr_id/value AS ehr_id,
  c/composition[openehr-ehr-composition.outpatient_high_complexity_procedures.v1]/outpatient_high_complexity_procedures/evaluation[openehr-ehr-evaluation.problem_diagnosis-sus.v1]/problem_diagnosis/item_tree[at0001]/structure/cluster[openehr-ehr-cluster.tnm_staging-sus.v1]/tumour_-_tnm_cancer_staging/cluster[at0002]/clinical_(ctnm)/element[at0010]/clinical_staging/value AS clinical_staging
FROM EHR e
CONTAINS COMPOSITION c
WHERE
  c/composition[openehr-ehr-composition.outpatient_high_complexity_procedures.v1]/outpatient_high_complexity_procedures/evaluation[openehr-ehr-evaluation.problem_diagnosis-sus.v1]/problem_diagnosis/item_tree[at0001]/structure/cluster[openehr-ehr-cluster.tnm_staging-sus.v1]/tumour_-_tnm_cancer_staging/cluster[at0002]/clinical_(ctnm)/element[at0010]/clinical_staging/value = 'Stage III'
