SELECT
  e/ehr_id/value AS ehr_id,
  c/composition[openehr-ehr-composition.outpatient_high_complexity_procedures.v1]/outpatient_high_complexity_procedures/admin_entry[openehr-ehr-admin_entry.high_complexity_procedures_sus.v1]/hcpa/item_tree[at0001]/components/cluster[at0016]/chemotherapy/element[at0031]/date_of_beginning_of_chemotherapy/value AS date_of_beginning_of_chemotherapy
FROM EHR e
CONTAINS COMPOSITION c
WHERE
  c/composition[openehr-ehr-composition.outpatient_high_complexity_procedures.v1]/outpatient_high_complexity_procedures/admin_entry[openehr-ehr-admin_entry.high_complexity_procedures_sus.v1]/hcpa/item_tree[at0001]/components/cluster[at0016]/chemotherapy/element[at0031]/date_of_beginning_of_chemotherapy/value > '2021-06-01'
