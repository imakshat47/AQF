SELECT
  e/ehr_id/value AS ehr_id,
  c/composition[openehr-ehr-composition.outpatient_high_complexity_procedures.v1]/outpatient_high_complexity_procedures/admin_entry[openehr-ehr-admin_entry.patient_discharge.v1]/patient_discharge/item_tree[at0001]/components/element[at0002]/date_of_discharge/value AS date_of_discharge
FROM EHR e
CONTAINS COMPOSITION c
WHERE
  c/composition[openehr-ehr-composition.outpatient_high_complexity_procedures.v1]/outpatient_high_complexity_procedures/admin_entry[openehr-ehr-admin_entry.patient_discharge.v1]/patient_discharge/item_tree[at0001]/components/element[at0002]/date_of_discharge/value >= '2023-01-01' AND c/composition[openehr-ehr-composition.outpatient_high_complexity_procedures.v1]/outpatient_high_complexity_procedures/admin_entry[openehr-ehr-admin_entry.patient_discharge.v1]/patient_discharge/item_tree[at0001]/components/element[at0002]/date_of_discharge/value <= '2023-01-31'
